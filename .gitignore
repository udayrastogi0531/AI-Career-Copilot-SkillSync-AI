# Dependency directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (sensitive credentials)
.env
.env.local
.env.production
.env.development
backend/.env
frontend/.env
*.env

# Production build outputs
dist/
build/
dist-ssr/
*.local

# System files & logs
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
