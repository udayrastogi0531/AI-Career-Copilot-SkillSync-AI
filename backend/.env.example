# ---------------------------------------------------------------------------
# Core (required - the server refuses to start without these)
# ---------------------------------------------------------------------------
PORT=5050
MONGODB_URI=mongodb://localhost:27017/career_copilot
# Optional secondary URI (standard, non-SRV connection string)
MONGODB_URI_STANDARD=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Chat/analysis model. Must be a Gemini model available to your API key.
GEMINI_MODEL=models/gemini-2.5-flash
# Embedding model used by the grounded career coach knowledge base.
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Hard timeout for a single Gemini call (ms). Provider failures are reported,
# never replaced with fabricated output.
GEMINI_TIMEOUT_MS=45000
# Optional: JSON object overriding deterministic ATS weights, e.g.
# {"required_skills":0.3,"keyword_coverage":0.2,"preferred_skills":0.08,
#  "experience_alignment":0.15,"role_alignment":0.08,"education_alignment":0.04,
#  "section_completeness":0.06,"formatting":0.05,"achievement_evidence":0.04}
ATS_WEIGHTS_JSON=

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ---------------------------------------------------------------------------
# Web origin and CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5180
# Optional comma-separated extra allowed origins (production frontends).
# Wildcard *.vercel.app / *.onrender.com origins are NOT allowed.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Transactional email (required for signup verification and password reset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender domain, otherwise only the Resend account owner
# receives mail.
RESEND_FROM_EMAIL=
# Enforce email verification before login. Keep false until RESEND_FROM_EMAIL is
# a verified domain: the shared onboarding@resend.dev sender cannot deliver to
# anyone except the Resend account owner, so enabling this locks new users out.
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# LaTeX compilation (resume studio)
# ---------------------------------------------------------------------------
# Preferred in production: URL of an ISOLATED LaTeX compiler service that
# accepts {"source": "..."} and returns application/pdf.
LATEX_COMPILE_URL=
# Optional bearer token for that service.
LATEX_COMPILE_TOKEN=
# Local development only: path to a Tectonic or pdfLaTeX binary.
# If empty, backend/.tools/tectonic[.exe] and PATH are checked.
LATEX_BIN=
# Set to true to allow local sandboxed compilation in production.
# Default false: production returns 503 instead of running TeX on the API host.
LATEX_ALLOW_LOCAL=false
LATEX_TIMEOUT_MS=45000
LATEX_MAX_SOURCE_BYTES=200000
LATEX_MAX_OUTPUT_BYTES=5242880

# ---------------------------------------------------------------------------
# Job posting fetching
# ---------------------------------------------------------------------------
JOB_FETCH_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Uploaded document parsing (PDF / DOCX)
# ---------------------------------------------------------------------------
# Each upload is parsed in an isolated worker thread with a capped heap. This is
# the wall-clock budget before that worker is terminated and the upload is
# rejected. Raise it only for very slow hosts; it bounds worst-case CPU per
# request, not document size.
DOCUMENT_PARSE_TIMEOUT_MS=10000
